<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Jellyfin.Plugin.NostrAuth</RootNamespace>
    <Version>0.1.4</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.1.4.0</FileVersion>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plugin controllers (POST /NostrAuth/Login) are ASP.NET Core MVC actions. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Host-provided assemblies: compile against them, never ship them. -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <!-- Embedded resources: the dashboard config page (IHasWebPages) and the
         pre-login Nostr login page + its vendored nostr-tools bundle,
         served anonymously by NostrAuthController. -->
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\loginPage.html" />
    <EmbeddedResource Include="Web\nostr.mjs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the license inside the plugin zip (GPL §4 distribution). -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NostrAuth.Core\NostrAuth.Core.csproj" />
  </ItemGroup>

</Project>
