{
  "loginUrl": "https://jellyfin.example.com/NostrAuth/Login",
  "requestBody": "{\"deviceId\":\"test-device\",\"clientName\":\"web\",\"clientVersion\":\"1.0\"}",
  "cases": [
    {
      "name": "valid event within freshness window is accepted",
      "authorization": "Nostr ",
      "now": 1760000010,
      "expect": "accept",
      "expectPubkey": "4f355bdcb7cc0af728ef3cceb9615d90684bb5b2ca5f859ab0f0b704075871aa"
    },
    {
      "name": "created_at older than 60s is rejected",
      "authorization": "Nostr ",
      "now": 1760000000,
      "expect": "reject",
      "expectReason": "expired_event"
    },
    {
      "name": "created_at in the future beyond tolerance is rejected",
      "authorization": "Nostr ",
      "now": 1760000000,
      "expect": "reject",
      "expectReason": "expired_event"
    },
    {
      "name": "u tag not matching request URL is rejected",
      "authorization": "Nostr ",
      "now": 1760000010,
      "expect": "reject",
      "expectReason": "url_mismatch"
    },
    {
      "name": "method tag not matching HTTP method is rejected",
      "authorization": "Nostr ",
      "now": 1760000010,
      "expect": "reject",
      "expectReason": "method_mismatch"
    },
    {
      "name": "non-27235 kind is rejected",
      "authorization": "Nostr ",
      "now": 1760000010,
      "expect": "reject",
      "expectReason": "invalid_event"
    },
    {
      "name": "tampered signature is rejected",
      "authorization": "Nostr ",
      "now": 1760000010,
      "expect": "reject",
      "expectReason": "invalid_event"
    },
    {
      "name": "payload hash matching request body is accepted",
      "authorization": "Nostr ",
      "requestBody": "{\"deviceId\":\"test-device\",\"clientName\":\"web\",\"clientVersion\":\"1.0\"}",
      "now": 1760000010,
      "expect": "accept",
      "expectPubkey": "4f355bdcb7cc0af728ef3cceb9615d90684bb5b2ca5f859ab0f0b704075871aa"
    },
    {
      "name": "payload hash not matching request body is rejected",
      "authorization": "Nostr ",
      "requestBody": "{\"deviceId\":\"different\"}",
      "now": 1760000010,
      "expect": "reject",
      "expectReason": "invalid_event"
    },
    {
      "name": "valid event from a non-allowlisted pubkey passes NIP-98 but is rejected by authorization",
      "authorization": "Nostr ",
      "now": 1760000010,
      "expect": "accept",
      "expectPubkey": "466d7fcae563e5cb09a0d1870bb580344804617879a14949cf22285f1bae3f27",
      "expectNotInAllowlist": true
    }
  ]
}
